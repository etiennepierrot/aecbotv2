# Base Postgres + pgvector (docker compose en local, Neon UE en production)
DATABASE_URL=postgresql://aecbot:aecbot@localhost:5432/aecbot

# Une des deux clés suffit. Mistral en direct (traitement UE) est préféré si les deux sont là.
MISTRAL_API_KEY=
# Sinon OpenRouter : mêmes modèles Mistral (mistral-embed, Mistral Small, Mistral Medium).
OPENROUTER_API_KEY=

# Site WordPress du programme
WP_BASE_URL=https://melenchon2027.fr

# Éditions interrogées. Tant que le programme 2027 n'est pas publié : aec2027,aec2022
# (les réponses tirées de 2022 disent que cette version n'est pas à jour). Ensuite : aec2027
EDITIONS=aec2027,aec2022

# Scan nocturne planifié par Mastra (heure de Paris). Laisser vide pour désactiver.
INGEST_CRON=0 3 * * *

# Modèle de réponse et juge de fidélité (évals). Vides = Mistral Small / Medium,
# en direct ou via OpenRouter selon la clé fournie.
AEC_MODEL=
AEC_JUDGE_MODEL=
# Contrôle des réponses partielles (src/aec/objet.ts) ; par défaut, le modèle du juge.
# AEC_CHECK_MODEL=

# Seulement pour comparer avec GPT-5 mini en direct dans les évals
OPENAI_API_KEY=

# Bot Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
# Secret du webhook : chaîne aléatoire, ex. `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=
# Clé de pseudonymisation des identifiants Telegram (32 caractères au moins). Ne plus la changer ensuite.
PSEUDONYM_SECRET=
# Identifiants Telegram de l'équipe (/ajouter, /docs, /supprimer), séparés par des virgules
TEAM_TELEGRAM_IDS=
RATE_LIMIT_PER_HOUR=20
MEMORY_DAYS=30
# Purge nocturne des conversations (heure de Paris)
PURGE_CRON=30 3 * * *

# En production : jeton exigé sur /api/* (Studio, agents, workflows)
ADMIN_API_TOKEN=
# Similarité minimale d'une suite proposée avec le corpus (calibrer : pnpm suites:calibrer)
SUITES_MIN_SCORE=0.8
# Copie des traces et votes vers Mastra Cloud (Observability). Vide : rien ne part.
# Ni la purge ni /oublier n'effacent cette copie.
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=
